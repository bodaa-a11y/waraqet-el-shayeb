rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isRoomMember(roomId) {
      return isSignedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/rooms/$(roomId)).data.memberIds;
    }

    function isValidImageAttachment() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;
    }

    function isValidAudioAttachment() {
      return request.resource.contentType.matches('audio/(aac|mp4|mpeg|ogg|wav|webm|x-m4a)')
        && request.resource.size > 0
        && request.resource.size <= 3 * 1024 * 1024;
    }

    match /rooms/{roomId}/evidence/{challengeInstanceId}/{uid}/{fileName} {
      allow read: if isRoomMember(roomId);

      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && isRoomMember(roomId)
        && fileName.size() <= 120
        && (isValidImageAttachment() || isValidAudioAttachment())
        && request.resource.metadata['ownerUid'] == request.auth.uid
        && request.resource.metadata['roomId'] == roomId;

      allow delete: if isSignedIn()
        && request.auth.uid == uid
        && isRoomMember(roomId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
